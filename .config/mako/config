# Mako notification daemon - ii color scheme
background-color=#1a1a1a
text-color=#e6e1e1
border-color=#49464a
border-size=1
border-radius=10
padding=12
margin=8

font=Google Sans Flex 12
max-icon-size=32
icon-path=/usr/share/icons/hicolor

default-timeout=5000
ignore-timeout=0
max-visible=5

layer=overlay
anchor=top-right

[urgency=low]
border-color=#49464a
default-timeout=3000

[urgency=normal]
border-color=#49464a

[urgency=high]
border-color=#ffb4ab
text-color=#ffdad6
default-timeout=0
