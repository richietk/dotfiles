DB="$HOME/.config/mozilla/firefox/default/places.sqlite"
LOG="$HOME/.local/share/firefox-history-log/history.log"
STATE="$HOME/.local/share/firefox-history-log/.last_timestamp"
TMP_DB="${TMPDIR:-/tmp}/firefox-history-watcher.sqlite"

mkdir -p "$(dirname "$LOG")"

if [[ ! -f "$STATE" ]]; then
    echo "0" > "$STATE"
fi

query_new() {
    local last_ts new_last_ts ts url title
    last_ts=$(cat "$STATE")
    new_last_ts="$last_ts"

    cp "$DB" "$TMP_DB" 2>/dev/null || return 0
    cp "${DB}-wal" "${TMP_DB}-wal" 2>/dev/null || true
    cp "${DB}-shm" "${TMP_DB}-shm" 2>/dev/null || true

    while IFS='|' read -r ts url title; do
        [[ -z "$url" ]] && continue
        printf '%s|%s|%s\n' \
            "$(date -d "@$((ts / 1000000))" '+%Y-%m-%d %H:%M:%S')" \
            "$url" \
            "$title" >> "$LOG"
        new_last_ts="$ts"
    done < <(sqlite3 "$TMP_DB" \
        "SELECT last_visit_date, url, title FROM moz_places
         WHERE last_visit_date > ${last_ts} AND last_visit_date IS NOT NULL
         ORDER BY last_visit_date ASC;" 2>/dev/null)

    if [[ "$new_last_ts" != "$last_ts" ]]; then
        echo "$new_last_ts" > "$STATE"
    fi
}

# Catch up on anything missed while the service was down
query_new

inotifywait -m -q -e close_write,moved_to \
    --include 'places\.sqlite' \
    "$(dirname "$DB")" | while read -r _dir _event _file; do
    sleep 1
    query_new
done
