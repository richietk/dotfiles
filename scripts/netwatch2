#!/usr/bin/env bash
# netwatch — live outbound traffic monitor using tshark
# Usage: netwatch [interface] [refresh_seconds]

IFACE="${1:-$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')}"
REFRESH="${2:-3}"

if ! command -v tshark &>/dev/null; then
    echo "tshark not found. Install: sudo pacman -S wireshark-cli" >&2; exit 1
fi
if [[ -z "$IFACE" ]]; then
    echo "Could not detect interface. Available:" >&2
    tshark -D 2>/dev/null | awk '{print "  " $0}' >&2; exit 1
fi
if [[ $EUID -ne 0 ]] && ! id -nG | grep -qw wireshark; then
    echo "Need root or wireshark group: sudo usermod -aG wireshark $USER" >&2; exit 1
fi

# IPFILE:    one destination IP per packet line (for counting)
# LBLFILE:   ip<tab>label — best known label per IP (SNI/HTTP host/reverse DNS)
IPFILE=$(mktemp)
LBLFILE=$(mktemp)

cleanup() { kill "$BGPID" "$RESOLVER_PID" 2>/dev/null; rm -f "$IPFILE" "$LBLFILE"; }
trap cleanup INT TERM EXIT

# === Capture: write every dst IP, and cache any named label we see ===
tshark -i "$IFACE" -l -q \
    -T fields \
    -e ip.dst \
    -e ip.dst_host \
    -e http.host \
    -e tls.handshake.extensions_server_name \
    -N n \
    2>/dev/null | \
while IFS=$'\t' read -r ip dns_host http_host sni; do
    ip="${ip%%,*}"   # tshark can return comma-separated IPs on tunneled packets; take first
    [[ -z "$ip" ]] && continue
    echo "$ip" >> "$IPFILE"
    # Pick best label tshark gave us; skip if it's just the raw IP again
    if   [[ -n "$sni" && "$sni" != "$ip" ]];            then label="$sni"
    elif [[ -n "$http_host" && "$http_host" != "$ip" ]]; then label="$http_host"
    elif [[ -n "$dns_host" && "$dns_host" != "$ip" ]];   then label="$dns_host"
    else continue
    fi
    printf '%s\t%s\n' "$ip" "$label" >> "$LBLFILE"
done &
BGPID=$!

# === Background resolver: reverse-DNS any IP not yet in label cache ===
(
    while true; do
        sleep 2
        [[ -s "$IPFILE" ]] || continue

        # IPs seen but not yet labelled
        comm -23 \
            <(sort -u "$IPFILE" 2>/dev/null) \
            <(awk -F'\t' '{print $1}' "$LBLFILE" 2>/dev/null | sort -u) \
        | while read -r ip; do
            name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2; exit}')
            [[ -n "$name" && "$name" != "$ip" ]] && printf '%s\t%s\n' "$ip" "$name" >> "$LBLFILE"
        done
    done
) &
RESOLVER_PID=$!

divider=$(printf '─%.0s' {1..72})
printf '\033[1mnetwatch  %s  —  refreshing every %ss  (Ctrl+C to stop)\033[0m\n\n' "$IFACE" "$REFRESH"

# === Display loop ===
while kill -0 "$BGPID" 2>/dev/null; do
    sleep "$REFRESH"
    clear
    printf '\033[1m netwatch  ·  %s  ·  %s \033[0m\n\n' "$IFACE" "$(date +%H:%M:%S)"
    printf '\033[1m%-7s  %-22s  %s\033[0m\n' "PACKETS" "DESTINATION IP" "HOST / URL / COMPANY"
    echo "$divider"

    if [[ -s "$IPFILE" ]]; then
        # Count packets per IP, merge with best label from LBLFILE
        awk -F'\t' -v lbl="$LBLFILE" '
            BEGIN { while ((getline line < lbl) > 0) {
                split(line, a, "\t"); cache[a[1]] = a[2]
            }}
            { count[$1]++ }
            END {
                for (ip in count) {
                    label = (ip in cache) ? cache[ip] : ip
                    print count[ip] "\t" ip "\t" label
                }
            }
        ' "$IPFILE" \
            | sort -rn \
            | head -30 \
            | while IFS=$'\t' read -r count ip label; do
                printf '%-7s  %-22s  %s\n' "$count" "$ip" "$label"
              done

        echo ""
        total=$(wc -l < "$IPFILE")
        uniq_ips=$(sort -u "$IPFILE" | wc -l)
        resolved=$(awk -F'\t' '{print $1}' "$LBLFILE" 2>/dev/null | sort -u | wc -l)
        printf 'Total packets: %-6s  Unique IPs: %-4s  Resolved: %s\n' "$total" "$uniq_ips" "$resolved"
    else
        echo "  (waiting for traffic...)"
    fi
done
